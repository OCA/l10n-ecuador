<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- A single page covers both purchase forms: the liquidation form
         inherits account.view_move_form, so this extension (a child of the
         EDI view on that same base) composes into it as well. A second
         record on the liquidation view would render the page twice. -->
    <record id="view_move_form_reimbursement" model="ir.ui.view">
        <field name="name">account.move.form.reimbursement</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_ec_account_edi.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@id='other_tab']" position="before">
                <page
                    string="Reimbursements"
                    name="l10n_ec_reimbursement"
                    invisible="move_type != 'in_invoice' or l10n_latam_internal_type not in ('invoice', 'purchase_liquidation')"
                >
                    <field name="reimbursement_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="doc_code" />
                            <field name="supplier_id_type" />
                            <field name="supplier_id" />
                            <field name="sri_number" />
                            <field name="issue_date" />
                            <field name="auth_number" />
                            <field name="base_amount" />
                            <field name="taxed_base" column_invisible="1" />
                            <field name="no_tax_base" column_invisible="1" />
                            <field name="exempt_base" column_invisible="1" />
                            <field name="ice_amount" column_invisible="1" />
                            <field name="iva_amount" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
