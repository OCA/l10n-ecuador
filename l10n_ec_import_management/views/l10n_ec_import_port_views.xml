<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_ec_import_port_list" model="ir.ui.view">
        <field name="name">l10n_ec.import.port.list</field>
        <field name="model">l10n_ec.import.port</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="country_id"/>
                <field name="is_water"/>
                <field name="is_air"/>
                <field name="is_land"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_ec_import_port_form" model="ir.ui.view">
        <field name="name">l10n_ec.import.port.form</field>
        <field name="model">l10n_ec.import.port</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code" placeholder="e.g. ECGYE"/>
                            <field name="country_id"/>
                            <field name="state_id"/>
                        </group>
                        <group string="Transport">
                            <field name="is_water"/>
                            <field name="is_air"/>
                            <field name="is_land"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_l10n_ec_import_port_search" model="ir.ui.view">
        <field name="name">l10n_ec.import.port.search</field>
        <field name="model">l10n_ec.import.port</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="country_id"/>
                <filter name="water" string="Sea" domain="[('is_water', '=', True)]"/>
                <filter name="air" string="Air" domain="[('is_air', '=', True)]"/>
                <filter name="land" string="Land" domain="[('is_land', '=', True)]"/>
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_l10n_ec_import_port" model="ir.actions.act_window">
        <field name="name">Ports</field>
        <field name="res_model">l10n_ec.import.port</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
