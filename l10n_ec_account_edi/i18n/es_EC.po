#. module: l10n_ec_account_edi
#: model:mail.template,body_html:l10n_ec_account_edi.email_template_notify
msgid ""
"<div>\n"
"                Dear,\n"
"                <br/>\n"
"                This email is to notify you that the certificate\n"
"                <t t-out=\"object.name\"/> is next to expire on <t t-out=\"object.expire_date\"/>.\n"
"                <br/>\n"
"                If this certificate is not renewed, the system will not be able\n"
"                to sign documents.\n"
"                <br/>\n"
"                Thanks for your attention.\n"
"            </div>\n"
"        "
msgstr ""
"<div>\n"
"                Querido,\n"
"                <br/>\n"
"                Este correo electrónico es para notificarle que el certificado\n"
"                <t t-out=\"object.name\"/> está próximo a caducar el <t t-out=\"object.expire_date\"/>.\n"
"                <br/>\n"
"                Si este certificado no se renueva, el sistema no podrá\n"
"                para firmar documentos.\n"
"                <br/>\n"
"                Gracias por su atención.\n"
"            </div>"

#. module: l10n_ec_account_edi
#: model:mail.template,body_html:l10n_ec_account_edi.email_template_unauthorized_notify
msgid ""
"<p>\n"
"                Dear,\n"
"                <br/>\n"
"                This email is to notify you that the documents electronics\n"
"                are unauthorized.\n"
"                <br/>\n"
"            </p>\n"
"            <t t-set=\"records\" t-value=\"object.l10n_ec_get_edi_document_unauthorized()\"/>\n"
"            <table width=\"100%\">\n"
"                <thead>\n"
"                    <tr style=\"text-align: center;\">\n"
"                        <th style=\"width: 190px;\">\n"
"                            <strong>Document</strong>\n"
"                        </th>\n"
"                        <th style=\"width: 80px;\">\n"
"                            <strong>Date</strong>\n"
"                        </th>\n"
"                        <th style=\"width: 80px;\">\n"
"                            <strong>Status</strong>\n"
"                        </th>\n"
"                        <th>\n"
"                            <strong>Error</strong>\n"
"                        </th>\n"
"                    </tr>\n"
"                </thead>\n"
"                <tbody style=\"padding: 10px; font-size: 12px;\">\n"
"                    <tr t-foreach=\"records\" t-as=\"r\">\n"
"                        <td>\n"
"                            <a t-attf-href=\"{{ r.move_id._get_share_url(redirect=True) }}\" target=\"_blank\" t-out=\"r.move_id.name or ''\">INV001</a>\n"
"                        </td>\n"
"                        <td style=\"text-align: center;\">\n"
"                            <span t-field=\"r.move_id.date\">2024-01-01</span>\n"
"                        </td>\n"
"                        <td style=\"text-align: center;\">\n"
"                            <span t-field=\"r.state\">Sent</span>\n"
"                        </td>\n"
"                        <td>\n"
"                            <span t-field=\"r.error\">Error</span>\n"
"                        </td>\n"
"                    </tr>\n"
"                </tbody>\n"
"            </table>\n"
"            <div>\n"
"                <br/>\n"
"                Thanks for your attention.\n"
"            </div>\n"
"        "
msgstr ""
"<p>\n"
"                Querido,\n"
"                <br/>\n"
"                Este correo electrónico es para notificarle que los documentos electrónicos\n"
"                no están autorizados.\n"
"                <br/>\n"
"            </p>\n"
"            <t t-set=\"registros\" t-value=\"object.l10n_ec_get_edi_document_unauthorized()\"/>\n"
"            <ancho de tabla=\"100%\">\n"
"                <cabeza>\n"
"                    <tr estilo=\"text-align: centro;\">\n"
"                        <th estilo=\"ancho: 190px;\">\n"
"                            <strong>Documento</strong>\n"
"                        </th>\n"
"                        <th estilo=\"ancho: 80px;\">\n"
"                            <strong>Fecha</strong>\n"
"                        </th>\n"
"                        <th estilo=\"ancho: 80px;\">\n"
"                            <strong>Estado</strong>\n"
"                        </th>\n"
"                        <th>\n"
"                            <strong>Error</strong>\n"
"                        </th>\n"
"                    </tr>\n"
"                </thead>\n"
"                <tbody style=\"relleno: 10px; tamaño de fuente: 12px;\">\n"
"                    <tr t-foreach=\"registros\" t-as=\"r\">\n"
"                        <td>\n"
"                            <a t-attf-href=\"{{ r.move_id._get_share_url(redirect=True) }}\" target=\"_blank\" t-out=\"r.move_id.name o ''\">INV001</a>\n"
"                        </td>\n"
"                        <td estilo=\"text-align: centro;\">\n"
"                            <span t-field=\"r.move_id.date\">2024-01-01</span>\n"
"                        </td>\n"
"                        <td estilo=\"text-align: centro;\">\n"
"                            <span t-field=\"r.state\">Enviado</span>\n"
"                        </td>\n"
"                        <td>\n"
"                            <span t-field=\"r.error\">Error</span>\n"
"                        </td>\n"
"                    </tr>\n"
"                </tbody>\n"
"            </tabla>\n"
"            <div>\n"
"                <br/>\n"
"                Gracias por su atención.\n"
"            </div>"

