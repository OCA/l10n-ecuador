<?xml version="1.0" encoding="utf-8" ?>
<!-- ============================================================
     Migrado a Odoo 19
     Cambios principales:
       1. <openerp> → <odoo>
       2. attrs={} → atributos inline (invisible/readonly/required)
       3. Chatter: div.oe_mail + mail_followers/mail_thread → <chatter/>
       4. invisible="1" → invisible="True"
       5. readonly="1"  → readonly="True"
       6. Eliminado atributo string="" obsoleto en <form>
     ============================================================ -->
<odoo>
    <data>

        <!-- ─── Menus ─────────────────────────────────────────────────── -->

        <menuitem name="Contracts"
            id="submenu_hr_contracts"
            parent="hr.menu_hr_root"
            sequence="20"
            groups="hr.group_hr_user"/>

        <!-- Reemplaza el menuitem stock de Contracts y lo coloca en el submenú -->
        <menuitem action="hr.action_hr_version"
                  id="menu_hr_contract_ec"
                  parent="submenu_hr_contracts"
                  name="Contracts"
                  sequence="10"
                  groups="hr.group_hr_user"/>

        <!-- ─── Jornada de Trabajo ────────────────────────────────────── -->

