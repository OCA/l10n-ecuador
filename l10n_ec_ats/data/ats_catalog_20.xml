<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- ====================================================================
         Source: Catalogo_ATS.xls, sheet "TABLAS REFERENCIALES".
         Columns: B = Tipo de Ingreso, C = Código Operación, D = Fecha Inicio (serial),
         E = Fecha fin (serial, '-' = open)
         Rows 512 to 513, one record per row, in source order.
         Record ids are suffixed with the 1-based position in that order,
         so ats_catalog_entry_<table>_<n> is row 512 + n - 1.
         Every value below was read from the cell named above; nothing is
         interpolated.
    -->
    <record id="ats_catalog_table_20" model="l10n.ec.ats.catalog.table">
        <field name="code">20</field>
        <field name="name">TIPO DE EMISIÓN FACTURACIÓN</field>
        <field
            name="source_reference"
        >Catalogo_ATS.xls / TABLAS REFERENCIALES / TABLA 20: TIPO DE EMISIÓN FACTURACIÓN (rows 512-513, title B509)</field>
        <field name="in_scope">1</field>
        <field name="entry_count">2</field>
        <field name="load_order">110</field>
    </record>
    <record id="ats_catalog_entry_20_1" model="l10n.ec.ats.catalog.entry">
        <field name="table_id" ref="ats_catalog_table_20" />
        <field name="code">F</field>
        <field name="description">Facturación Física</field>
        <field name="date_start">2000-01-01</field>
    </record>
    <record id="ats_catalog_entry_20_2" model="l10n.ec.ats.catalog.entry">
        <field name="table_id" ref="ats_catalog_table_20" />
        <field name="code">E</field>
        <field name="description">Facturación Electrónica</field>
        <field name="date_start">2016-01-01</field>
    </record>
</odoo>
