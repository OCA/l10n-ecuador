<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- ====================================================================
         Source: Catalogo_ATS.xls, sheet "TABLAS REFERENCIALES".
         Columns: E = Mes, F = Código
         Rows 7 to 18, one record per row, in source order.
         Record ids are suffixed with the 1-based position in that order,
         so ats_catalog_entry_<table>_<n> is row 7 + n - 1.
         Every value below was read from the cell named above; nothing is
         interpolated.
    -->
    <!--
      date_start 1900-01-01 is a SENTINEL, not a validity date. The sheet carries no
      date for this table (no date column, or the literal 'vacío' in every row) while
      the l10n.ec.temporal mixin makes date_start required. date_end stays empty so the
      entry reads as open-ended. See readme/ROADMAP.md for the open question.
    -->
    <record id="ats_catalog_table_01" model="l10n.ec.ats.catalog.table">
        <field name="code">01</field>
        <field name="name">PERÍODO - MES</field>
        <field
            name="source_reference"
        >Catalogo_ATS.xls / TABLAS REFERENCIALES / Tabla 1:  PERÍODO - MES (rows 7-18, title E5)</field>
        <field name="in_scope">1</field>
        <field name="entry_count">12</field>
        <field name="load_order">20</field>
    </record>
    <record id="ats_catalog_entry_01_1" model="l10n.ec.ats.catalog.entry">
        <field name="table_id" ref="ats_catalog_table_01" />
        <field name="code">01</field>
        <field name="description">Enero</field>
        <field name="date_start">1900-01-01</field>
