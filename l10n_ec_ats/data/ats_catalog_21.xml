        >Catalogo_ATS.xls / TABLAS REFERENCIALES / TABLA 21: TIPO DE COMPENSACIONES (rows 519-520, title B516)</field>
        <field name="in_scope">1</field>
        <field name="entry_count">2</field>
        <field name="load_order">120</field>
    </record>
    <record id="ats_catalog_entry_21_1" model="l10n.ec.ats.catalog.entry">
        <field name="table_id" ref="ats_catalog_table_21" />
        <field name="code">01</field>
        <field name="description">Ley Solidaridad -Zonas Afectadas</field>
        <field name="date_start">2016-06-01</field>
