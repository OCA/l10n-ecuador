<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- ====================================================================
         Source: Catalogo_ATS.xls, sheet "TABLAS REFERENCIALES".
         Columns: B = Tipo, C = Código
         Rows 266 to 267, one record per row, in source order.
         Record ids are suffixed with the 1-based position in that order,
         so ats_catalog_entry_<table>_<n> is row 266 + n - 1.
         Every value below was read from the cell named above; nothing is
         interpolated.
    -->
    <!--
      date_start 1900-01-01 is a SENTINEL, not a validity date. The sheet carries no
      date for this table (no date column, or the literal 'vacío' in every row) while
      the l10n.ec.temporal mixin makes date_start required. date_end stays empty so the
      entry reads as open-ended. See readme/ROADMAP.md for the open question.
    -->
    <record id="ats_catalog_table_14" model="l10n.ec.ats.catalog.table">
        <field name="code">14</field>
        <field name="name">TIPO DE IDENTIFICACIÓN DEL PROVEEDOR</field>
        <field
            name="source_reference"
        >Catalogo_ATS.xls / TABLAS REFERENCIALES / TABLA 14: TIPO DE IDENTIFICACIÓN DEL PROVEEDOR (rows 266-267, title B264)</field>
        <field name="in_scope">1</field>
        <field name="entry_count">2</field>
        <field name="load_order">90</field>
    </record>
    <record id="ats_catalog_entry_14_1" model="l10n.ec.ats.catalog.entry">
        <field name="table_id" ref="ats_catalog_table_14" />
        <field name="code">01</field>
        <field name="description">PERSONA NATURAL</field>
        <field name="date_start">1900-01-01</field>
    </record>
    <record id="ats_catalog_entry_14_2" model="l10n.ec.ats.catalog.entry">
        <field name="table_id" ref="ats_catalog_table_14" />
        <field name="code">02</field>
        <field name="description">SOCIEDAD</field>
        <field name="date_start">1900-01-01</field>
    </record>
</odoo>
