#. odoo-python
#: code:addons/l10n_ec_ats/wizard/l10n_ec_ats_generate.py:0
msgid ""
"%(count)s finding(s) did not stop this file. They are not blocking, but the SRI may question them, so read them before filing:\n"
"\n"
"%(lines)s"
msgstr ""

#. module: l10n_ec_ats
#. odoo-python
#: code:addons/l10n_ec_ats/wizard/l10n_ec_ats_generate.py:0
msgid "%(index)s. %(rule)s -- %(where)s%(field)s %(message)s"
msgstr ""

#. module: l10n_ec_ats
#. odoo-python
#: code:addons/l10n_ec_ats/models/l10n_ec_ats_collector.py:0
msgid ""
"%(move)s cannot be reported in the ATS: %(field)s is %(value)s. The SRI "
"numbers establishments and emission points from 001; 000 is never valid, "
"even though ats.xsd accepts it."
msgstr ""

#. module: l10n_ec_ats
#. odoo-python
#: code:addons/l10n_ec_ats/models/l10n_ec_ats_collector.py:0
msgid ""
"%(move)s cannot be reported in the ATS: Tabla 20 has %(count)s rows in force"
" on %(when)s for journal %(journal)s, which %(uses)s. Exactly one is "
"required, and ATS will not guess the emission type. Codes in force that day:"
" %(valid)s."
msgstr ""

#. module: l10n_ec_ats
#. odoo-python
#: code:addons/l10n_ec_ats/models/l10n_ec_ats_collector.py:0
msgid ""
"%(move)s cannot be reported in the ATS: another cancelled document already "
"claims sequential %(sequence)s of establishment %(establishment)s and "
"emission point %(point)s. Two records claiming one document is a data error "
"to fix, not a second range."
msgstr ""

#. module: l10n_ec_ats
#. odoo-python
#: code:addons/l10n_ec_ats/models/l10n_ec_ats_collector.py:0
msgid ""
"%(move)s cannot be reported in the ATS: document type %(code)s (%(name)s) is"
" not one tax support %(support)s covers. Tabla 5 allows: %(allowed)s."
msgstr ""

#. module: l10n_ec_ats
#. odoo-python
#: code:addons/l10n_ec_ats/models/l10n_ec_ats_collector.py:0
msgid ""
"%(move)s cannot be reported in the ATS: fechaEmision %(emission)s is after "
"fechaRegistro %(registration)s."
msgstr ""

#. module: l10n_ec_ats
#. odoo-python
#: code:addons/l10n_ec_ats/models/l10n_ec_ats_collector.py:0
msgid ""
"%(move)s cannot be reported in the ATS: fechaEmision %(emission)s is more "
"than a year before fechaRegistro %(registration)s."
msgstr ""

#. module: l10n_ec_ats
#. odoo-python
#: code:addons/l10n_ec_ats/models/l10n_ec_ats_collector.py:0
msgid ""
"%(move)s cannot be reported in the ATS: fechaRegistro %(date)s falls outside"
" the reported period %(month)s. An ATS covers one month, and fechaRegistro "
"must equal it."
msgstr ""

#. module: l10n_ec_ats
#. odoo-python
#: code:addons/l10n_ec_ats/models/l10n_ec_ats_collector.py:0
msgid ""
"%(move)s cannot be reported in the ATS: fechaRegistro is not set. Set the "
"accounting date on the document."
msgstr ""

#. module: l10n_ec_ats
#. odoo-python
#: code:addons/l10n_ec_ats/models/l10n_ec_ats_collector.py:0
msgid ""
"%(move)s cannot be reported in the ATS: it carries no document number, and "
"its access key does not carry one either. ATS reads the establishment, the "
"emission point and the sequential from the number the SRI received, so a "
"cancelled document has to keep it."
msgstr ""

#. module: l10n_ec_ats
#. odoo-python
#: code:addons/l10n_ec_ats/models/l10n_ec_ats_collector.py:0
msgid ""
"%(move)s cannot be reported in the ATS: its sequential %(sequence)s is not a"
" number, and a range is opened and closed by comparing one sequential with "
"the next. Record the number on the document as ESTABLISHMENT-POINT-"
"SEQUENTIAL."
msgstr ""

#. module: l10n_ec_ats
#. odoo-python
#: code:addons/l10n_ec_ats/models/l10n_ec_ats_collector.py:0
msgid ""
"%(move)s cannot be reported in the ATS: no authorization number is recorded "
"on it. The SRI issues that number when it authorizes the document, so one "
"that carries none was never authorized -- ATS will not invent it, and the "
"document is left out of the range instead of being folded into one."
msgstr ""

#. module: l10n_ec_ats
#. odoo-python
#: code:addons/l10n_ec_ats/models/l10n_ec_ats_collector.py:0
msgid ""
"%(move)s cannot be reported in the ATS: no tax support is captured. Tabla 5 "
"requires exactly one code per document, and ATS does not guess it."
msgstr ""

#. module: l10n_ec_ats
#. odoo-python
#: code:addons/l10n_ec_ats/models/l10n_ec_ats_collector.py:0
msgid ""
"%(move)s cannot be reported in the ATS: the document type is not set. Tabla "
"4 requires one."
msgstr ""

#. module: l10n_ec_ats
#. odoo-python
#: code:addons/l10n_ec_ats/models/l10n_ec_ats_collector.py:0
msgid ""
"%(move)s cannot be reported in the ATS: the supplier's authorization number "
"is not set. ATS will not invent one. Record it on the bill, or leave the "
"document out of the period until it is known."
msgstr ""

#. module: l10n_ec_ats
#. odoo-python
#: code:addons/l10n_ec_ats/models/l10n_ec_ats_collector.py:0
msgid ""
"%(move)s cannot be reported in the ATS: the supplier's document number is "
"not set and its access key does not carry one either. Record the number on "
"the bill as ESTABLISHMENT-POINT-SEQUENTIAL."
msgstr ""

#. module: l10n_ec_ats
#. odoo-python
#: code:addons/l10n_ec_ats/models/l10n_ec_ats_collector.py:0
msgid ""
"%(move)s cannot be reported in the ATS: the supplier's emission date is not "
"set."
msgstr ""

#. module: l10n_ec_ats
#. odoo-python
#: code:addons/l10n_ec_ats/models/l10n_ec_ats_collector.py:0
msgid ""
"%(move)s states payment form %(code)s, which Tabla 13 does not publish on "
"%(when)s. Codes in force that day: %(valid)s."
msgstr ""

#. module: l10n_ec_ats
#. odoo-python
#: code:addons/l10n_ec_ats/models/l10n_ec_ats_collector.py:0
msgid ""
"%(move)s withholds VAT at %(rate)s%%, but Tabla 11 has %(count)s such rates "
"in force on %(when)s. Exactly one is required; ATS will not file a retention"
" under a rate the SRI never published."
msgstr ""

#. module: l10n_ec_ats
#. odoo-python
#: code:addons/l10n_ec_ats/models/l10n_ec_ats_collector.py:0
msgid ""
"%(move)s withholds VAT at %(rate)s%%, but Tabla 11 has %(count)s such rates "
"in force on %(when)s. Exactly one is required; ATS will not guess which "
"element the amount belongs in."
msgstr ""

#. module: l10n_ec_ats
#. odoo-python
#: code:addons/l10n_ec_ats/models/l10n_ec_ats_collector.py:0
msgid ""
"%(move)s withholds income tax under code %(code)s, which Tabla 3.10 does not"
" define. The tax's ATS code cannot be resolved to a rate, so no "
"porcentajeAir is reported for it. Check l10n_ec_code_ats on the tax."
msgstr ""

#. module: l10n_ec_ats
#. odoo-python
#: code:addons/l10n_ec_ats/models/l10n_ec_ats_collector.py:0
msgid ""
"%(partner)s has no identification number, so it cannot be reported as a "
"client."
msgstr ""

#. module: l10n_ec_ats
#. odoo-python
#: code:addons/l10n_ec_ats/models/l10n_ec_ats_collector.py:0
msgid ""
"%(partner)s has no identification number, so it cannot be reported as a "
"supplier."
msgstr ""

#. module: l10n_ec_ats
#. odoo-python
#: code:addons/l10n_ec_ats/models/l10n_ec_ats_collector.py:0
msgid ""
"%(partner)s is identified as %(vat)s, which is Consumer Final. The SRI files"
" no purchase against that identification; bill the real supplier."
msgstr ""

#. module: l10n_ec_ats
#. odoo-python
#: code:addons/l10n_ec_ats/models/l10n_ec_ats_collector.py:0
msgid ""
"%(partner)s is identified from abroad, so the ATS requires tipoCliente. "
"Tabla 14 states no row matching a %(nature)s client on %(when)s."
msgstr ""

#. module: l10n_ec_ats
#. odoo-python
#: code:addons/l10n_ec_ats/models/l10n_ec_ats_collector.py:0
msgid ""
"%(partner)s is identified from abroad, so the ATS requires tipoProv. Tabla "
"14 states no row matching a %(nature)s supplier on %(when)s."
msgstr ""

#. module: l10n_ec_ats
#. odoo-python
#: code:addons/l10n_ec_ats/models/l10n_ec_ats_collector.py:0
msgid ""
"%(partner)s uses an identification type the ATS does not describe, so "
"tpIdCliente cannot be derived from it."
msgstr ""

#. module: l10n_ec_ats
#. odoo-python
#: code:addons/l10n_ec_ats/models/l10n_ec_ats_collector.py:0
msgid ""
"%(partner)s uses an identification type the ATS does not describe, so "
"tpIdProv cannot be derived from it."
msgstr ""

#. module: l10n_ec_ats
#. odoo-python
#: code:addons/l10n_ec_ats/wizard/l10n_ec_ats_generate.py:0
msgid "%(rule)s -- %(where)s%(field)s %(message)s"
msgstr ""

#. module: l10n_ec_ats
#. odoo-python
#: code:addons/l10n_ec_ats/models/l10n_ec_ats_collector.py:0
msgid ""
"%(subject)s cannot be reported in the ATS: its establishment is %(code)s. "
"The SRI numbers establishments from 001, and numEstabRuc and codEstab both "
"carry minExclusive 000 in ats.xsd, so %(code)s is never valid in either "
"place."
msgstr ""

#. module: l10n_ec_ats
#. odoo-python
#: code:addons/l10n_ec_ats/models/l10n_ec_ats_collector.py:0
msgid ""
"%(vat)s is not a real identification number, so %(partner)s cannot be "
"reported as %(subject)s."
msgstr ""

