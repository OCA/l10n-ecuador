<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_ec_104_generate_view_form" model="ir.ui.view">
        <field name="name">l10n.ec.104.generate.form</field>
        <field name="model">l10n.ec.104.generate</field>
        <field name="arch" type="xml">
            <form string="Prefill Form 104">
                <group>
                    <group>
                        <field name="company_id" />
                        <field name="anio" />
                        <field name="mes" />
                    </group>
                    <group string="Return">
                        <div class="text-muted">
                            <p>
                                One prefill per reported month over the Form 104
                                report of Odoo core. Every derivable box is read
                                from the posted moves of that month, and a box
                                that cannot be derived stops generation rather
                                than being assumed. Prior-period boxes below
                                default to zero: fill them from your prior
                                filing when they apply.
                            </p>
                        </div>
                    </group>
                </group>
                <group string="Prior-period boxes (manual)">
                    <group>
                        <field name="carryover_483" />
                        <field name="carryover_603" />
                        <field name="carryover_604" />
                        <field name="carryover_605" />
                        <field name="carryover_606" />
                        <field name="carryover_607" />
                        <field name="carryover_608" />
                    </group>
                    <group>
                        <field name="carryover_610" />
                        <field name="carryover_611" />
                        <field name="carryover_612" />
                        <field name="carryover_613" />
                        <field name="carryover_614" />
                        <field name="carryover_621" />
                        <field name="carryover_800" />
                        <field name="carryover_802" />
                    </group>
                </group>
                <field name="boxes_preview" nolabel="1" readonly="1" />
                <footer>
                    <button
                        name="generate"
                        type="object"
                        string="Prefill"
                        class="btn-primary"
                    />
                    <button string="Discard" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="l10n_ec_104_generate_action" model="ir.actions.act_window">
        <field name="name">Form 104 (IVA)</field>
        <field name="res_model">l10n.ec.104.generate</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="l10n_ec_104_generate_view_form" />
        <field name="target">new</field>
    </record>

    <menuitem
        id="l10n_ec_104_generate_menu"
        name="Form 104 (IVA)"
        parent="l10n_ec.sri_menu"
        action="l10n_ec_104_generate_action"
        sequence="20"
    />
</odoo>
